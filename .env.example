# Copia este archivo como .env.local y rellena los valores.

# URL pública del sitio (opcional; en Vercel se resuelve automáticamente)
NEXT_PUBLIC_SITE_URL=

# Base de datos Postgres (Neon / Vercel Postgres)
DATABASE_URL=

# Auth.js (genera el secreto con: npx auth secret)
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email que tendrá rol de administrador
ADMIN_EMAIL=

# Google AdSense (opcional). Ejemplo de cliente: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_POPUP=
NEXT_PUBLIC_ADSENSE_SLOT_FLOATING=
